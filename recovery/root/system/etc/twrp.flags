# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point            <type>    <device>                        <device2>                <flags>

/boot                     emmc   /dev/block/bootdevice/by-name/boot
/dtbo                     emmc   /dev/block/bootdevice/by-name/dtbo                         flags=backup=1;display="DTBO";flashimg
/recovery                 emmc   /dev/block/bootdevice/by-name/recovery                     flags=backup=1;display="Recovery";flashimg
/firmware                 vfat   /dev/block/bootdevice/by-name/modem                        flags=display="Firmware";mounttodecrypt;fsflags=ro
/modem_image              emmc   /dev/block/bootdevice/by-name/modem                        flags=backup=1;display="Modem";flashimg
/bluetooth                vfat   /dev/block/bootdevice/by-name/bluetooth                    flags=display="Bluetooth";fsflags="ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0 wait"
/bluetooth                emmc   /dev/block/bootdevice/by-name/bluetooth                    flags=backup=1;display="Bluetooth";flashimg
/abl                      emmc   /dev/block/bootdevice/by-name/abl                          flags=backup=1;display="Firmware-update"
/aop                      emmc   /dev/block/bootdevice/by-name/aop                          flags=backup=1;subpartitionof=/abl
/cmnlib                   emmc   /dev/block/bootdevice/by-name/cmnlib                       flags=backup=1;subpartitionof=/abl
/cmnlib64                 emmc   /dev/block/bootdevice/by-name/cmnlib64                     flags=backup=1;subpartitionof=/abl
/devcfg                   emmc   /dev/block/bootdevice/by-name/devcfg                       flags=backup=1;subpartitionof=/abl
/qupfw                    emmc   /dev/block/bootdevice/by-name/qupfw                        flags=backup=1;subpartitionof=/abl
/keymaster                emmc   /dev/block/bootdevice/by-name/keymaster                    flags=backup=1;subpartitionof=/abl
/imagefv                  emmc   /dev/block/bootdevice/by-name/imagefv                      flags=backup=1;subpartitionof=/abl
/hyp                      emmc   /dev/block/bootdevice/by-name/hyp                          flags=backup=1;subpartitionof=/abl
/xbl                      emmc   /dev/block/bootdevice/by-name/xbl                          flags=backup=1;subpartitionof=/abl
/xbl_config               emmc   /dev/block/bootdevice/by-name/xbl_config                   flags=backup=1;subpartitionof=/abl
/storsec                  emmc   /dev/block/bootdevice/by-name/storsec                      flags=backup=1;subpartitionof=/abl
/tz                       emmc   /dev/block/bootdevice/by-name/tz                           flags=backup=1;subpartitionof=/abl
/dsp                      emmc   /dev/block/bootdevice/by-name/dsp                          flags=backup=1;subpartitionof=/abl
/persist                  ext4   /dev/block/bootdevice/by-name/persist                      flags=backup=1;display="Persist"
/persist_image            emmc   /dev/block/bootdevice/by-name/persist                      flags=backup=0;display="Persist";flashimg
/cust                     ext4   /dev/block/bootdevice/by-name/cust                         flags=backup=1;display="Cust"
/cust_image               emmc   /dev/block/bootdevice/by-name/cust                         flags=backup=0;display="Cust";flashimg
/storage                  f2fs   /data/media/0                                              flags=display="Internal Storage";usermrf;backup=1;fsflags="bind";removable
/efs1                     emmc   /dev/block/bootdevice/by-name/modemst1                     flags=backup=1;display="EFS"
/efs2                     emmc   /dev/block/bootdevice/by-name/modemst2                     flags=backup=1;subpartitionof=/efs1
/efsg                     emmc   /dev/block/bootdevice/by-name/fsg                          flags=backup=1;subpartitionof=/efs1
/efsc                     emmc   /dev/block/bootdevice/by-name/fsc                          flags=backup=1;subpartitionof=/efs1
/vbmeta                   emmc   /dev/block/bootdevice/by-name/vbmeta                       flags=backup=1;display="VBMeta";flashimg
/vbmeta_system            emmc   /dev/block/bootdevice/by-name/vbmeta_sysyem                flags=backup=1;display="VBMeta System";flashimg

# Removable storage
/external_sd              vfat     /dev/block/mmcblk0p1         /dev/block/mmcblk0          flags=fsflags=utf8;display="MicroSD";storage;wipeingui;removable
/usb_otg                  vfat     /dev/block/sdg1              /dev/block/sdg              flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable

